{
  "version": 1,
  "defaultAllowedPaths": [],
  "roles": {
    "master-control": {
      "allowedPaths": [".vibebus/**", "acceptance/**", "docs/**"]
    },
    "architecture": {
      "allowedPaths": ["docs/**"]
    },
    "development": {
      "allowedPaths": [
        "Cargo.lock",
        "Cargo.toml",
        "plugins/**",
        "scripts/**",
        "src/**",
        "tests/**"
      ]
    },
    "qa": {
      "allowedPaths": ["acceptance/**", "docs/acceptance.md", "scripts/test-*/**", "scripts/test-*", "tests/**"]
    },
    "git": {
      "allowedPaths": []
    },
    "ci-release": {
      "allowedPaths": [
        ".github/workflows/**",
        "Dockerfile",
        "deny.toml",
        "docker-compose.yml",
        "installer/**",
        "scripts/build-release.ps1",
        "scripts/package-plugin*",
        "scripts/plugin_package.py",
        "scripts/sign-windows.ps1",
        "scripts/validate-plugin*",
        "scripts/validate_plugin*"
      ]
    },
    "documentation": {
      "allowedPaths": ["CHANGELOG.md", "CONTRIBUTING.md", "README.md", "docs/**", "plugins/*/README.md"]
    },
    "security": {
      "allowedPaths": ["SECURITY.md", "acceptance/security/**", "docs/security/**"]
    },
    "coordination": {
      "allowedPaths": ["acceptance/**", "docs/**"]
    },
    "context-projection-implementation": {
      "allowedPaths": [
        ".github/workflows/**",
        "Cargo.lock",
        "Cargo.toml",
        "CHANGELOG.md",
        "README.md",
        "docs/**",
        "plugins/vibebus/**",
        "src/**",
        "tests/**"
      ]
    },
    "desktop-acceptance-coordinator": {
      "allowedPaths": ["acceptance/**"]
    },
    "desktop-acceptance-receiver": {
      "allowedPaths": ["acceptance/**"]
    },
    "implementation": {
      "allowedPaths": ["src/**", "tests/**"]
    },
    "release": {
      "allowedPaths": ["backups/**", "dist/**", "docs/**", "plugins/vibebus/**"]
    },
    "release-management": {
      "allowedPaths": ["**"]
    },
    "responsibility-policy-hooks-implementation": {
      "allowedPaths": [
        ".github/workflows/**",
        ".vibebus/**",
        "Cargo.lock",
        "Cargo.toml",
        "CHANGELOG.md",
        "README.md",
        "docs/**",
        "plugins/vibebus/**",
        "scripts/**",
        "src/**",
        "tests/**"
      ]
    }
  }
}
